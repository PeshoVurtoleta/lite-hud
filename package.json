{
  "name": "@zakkster/lite-hud",
  "version": "2.2.0",
  "description": "SPP-native zero-GC canvas overlay for the @zakkster profiler suite.",
  "type": "module",
  "main": "./Hud.js",
  "module": "./Hud.js",
  "types": "./Hud.d.ts",
  "exports": {
    ".": {
      "types": "./Hud.d.ts",
      "node": "./Hud.js",
      "import": "./Hud.js",
      "default": "./Hud.js"
    }
  },
  "files": [
    "Hud.js",
    "Hud.d.ts",
    "CHANGELOG.md",
    "llms.txt",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node --test test/Hud.test.js",
    "torture": "node --expose-gc test/torture.mjs",
    "torture:controls": "node test/controls.mjs",
    "test:perf": "node --expose-gc --max-semi-space-size=4 --test test/perf/",
    "verify": "npm test && npm run torture && npm run torture:controls && npm run test:perf"
  },
  "devDependencies": {
    "@zakkster/lite-gc-profiler": "^1.16.0",
    "@zakkster/lite-leak": "^1.10.0",
    "@zakkster/lite-perf-gate": "^1.4.2",
    "@zakkster/lite-sketch": "^1.1.0",
    "@zakkster/lite-viewport": "^1.1.0"
  },
  "peerDependencies": {
    "@zakkster/lite-sketch": "^1.1.0",
    "@zakkster/lite-viewport": "^1.1.0"
  },
  "peerDependenciesMeta": {
    "@zakkster/lite-sketch": {
      "optional": true
    },
    "@zakkster/lite-viewport": {
      "optional": true
    }
  },
  "keywords": [
    "hud",
    "overlay",
    "canvas",
    "profiler",
    "spp",
    "zero-gc",
    "lite"
  ],
  "author": "Zahary Shinikchiev <shinikchiev@yahoo.com>",
  "license": "MIT",
  "homepage": "https://github.com/PeshoVurtoleta/lite-hud#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeshoVurtoleta/lite-hud.git"
  },
  "bugs": {
    "url": "https://github.com/PeshoVurtoleta/lite-hud/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/PeshoVurtoleta"
  }
}
